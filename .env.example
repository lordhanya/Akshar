# Neon PostgreSQL (free tier). Get yours at neon.tech
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Better Auth secret (hex, 32 bytes). Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=31805f2164759a7b7a24ab338f7995327f2c736626975611717caa51f14450fe

# Base URLs (https://akshar.ashifcodes.tech in production)
BETTER_AUTH_URL=https://akshar.ashifcodes.tech
APP_BASE_URL=https://akshar.ashifcodes.tech

# Provider integrations (outbound HTTP to book APIs).
# Identified User-Agent + contact email — required/expected by Open Library
# and Gutenberg for polite, rate-limit-friendly access.
# Example: "Library/0.1 (server-side; contact: you@example.com)"
PROVIDER_USER_AGENT=Library/0.1 (server-side; contact: change_me@example.com)

# Resend email API (transactional mail from a verified akshar.ashifcodes.tech domain).
# Used for password-reset emails. Get a free key at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: cap per-call provider timeouts (ms) and Gutenberg content size (bytes).
PROVIDER_TIMEOUT_MS=10000
GUTENBERG_MAX_CONTENT_BYTES=4000000
